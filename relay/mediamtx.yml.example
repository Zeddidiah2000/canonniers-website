# Canonniers relay — MediaMTX ingest config TEMPLATE.
# The live copy on the VPS has the real passphrase/password inlined
# (generated by the install script). Replace <SRT_PASSPHRASE> and
# <RTMP_PUBLISH_PASS> with the values from .env.

logLevel: info

api: no
metrics: no
playback: no
rtsp: yes
rtspAddress: :8554        # internal only: not published in docker-compose
rtmp: yes
rtmpAddress: :1935
hls: no
webrtc: no
srt: yes
srtAddress: :8890

authInternalUsers:
  # local/in-compose readers (the burner + passthrough ffmpeg)
  - user: any
    ips: ['127.0.0.1', '::1', '172.16.0.0/12']
    permissions:
      - action: read
  # the only allowed publisher (Mevo / field encoder / CF Live Output)
  - user: mevo
    pass: <RTMP_PUBLISH_PASS>
    permissions:
      - action: publish

paths:
  live:
    srtPublishPassphrase: <SRT_PASSPHRASE>
