# Canonniers overlay relay — VPS environment (real values live in /home/ubuntu/relay/.env
# on the VPS ONLY; never commit them). See relay/RUNBOOK.md (Phase 5) for setup.

# MediaMTX ingest auth (generated at install; also entered in the Mevo app / CF Live Output)
SRT_PASSPHRASE=
RTMP_PUBLISH_USER=mevo
RTMP_PUBLISH_PASS=

# Overlay page the shotter screenshots
OVERLAY_URL=https://canonniersdequebec.ca/overlay-broadcast.html?team=u15

# CF Stream live input the BURNED feed publishes to (relay-burned-u15).
# CF_RTMPS_URL is shared; each burner uses its team's CF_STREAM_KEY_*.
CF_RTMPS_URL=rtmps://live.cloudflare.com:443/live/
CF_STREAM_KEY=
CF_INPUT_B_UID=

# CF Stream API token (Stream:Edit + Zone Firewall:Edit) — pregame scripting
CF_STREAM_TOKEN=

# Existing per-team CF live inputs (the Mevo/volunteer chain publishes here).
# A CF Live Output on each input A pushes into the relay (streamKey cdq/d1/d2 →
# MediaMTX path live/cdq | live/d1 | live/d2 → the matching burner).
CF_INPUT_A_U15=

# 17U D1 relay chain (burner-u17d1 → relay-burned-u17d1)
CF_INPUT_A_U17D1=
CF_INPUT_B_U17D1=
CF_STREAM_KEY_U17D1=
# 17U D2 relay chain (burner-u17d2 → relay-burned-u17d2)
CF_INPUT_A_U17D2=
CF_INPUT_B_U17D2=
CF_STREAM_KEY_U17D2=

# GameChanger clean passthrough (Phase 4) — fresh key every game
GC_RTMP_URL=
GC_STREAM_KEY=

# gc-poller → scorebug worker bearer (same value as the worker's POLLER_TOKEN
# secret, set via `wrangler secret put POLLER_TOKEN`)
POLLER_TOKEN=
# Test hook: a completed GC game id to replay as if live (blank in production)
FORCE_EVENT_ID=

# Throwaway GameChanger account (must FOLLOW the 15U team). Used ONLY by
# gc-poller/seed-login.js to seed the browserless token refresher — one coded
# login writes ./gc-auth/state.json (the ~14-day rotating refresh token + app
# clientKey), after which the `token-refresher` service mints tokens with no
# Chrome. Re-seed (~every 14 days) with seed-login.js. The old puppeteer
# mint-token.js / mint-loop.js + ./gc-profile remain as a manual fallback.
GC_EMAIL=
GC_PASSWORD=

# NOTE: ./gc-auth/state.json (refresh token + clientKey) and ./gc-profile/ hold
# secrets and are gitignored — they live on the VPS only, never commit them.
