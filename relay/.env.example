# Canonniers overlay relay — VPS environment (real values live in /home/ubuntu/relay/.env
# on the VPS ONLY; never commit them). See relay/RUNBOOK.md (Phase 5) for setup.

# MediaMTX ingest auth (generated at install; also entered in the Mevo app / CF Live Output)
SRT_PASSPHRASE=
RTMP_PUBLISH_USER=mevo
RTMP_PUBLISH_PASS=

# Overlay page the shotter screenshots
OVERLAY_URL=https://canonniersdequebec.ca/overlay-broadcast.html?team=u15

# CF Stream live input the BURNED feed publishes to (relay-burned-u15)
CF_RTMPS_URL=rtmps://live.cloudflare.com:443/live/
CF_STREAM_KEY=
CF_INPUT_B_UID=

# CF Stream API token (Stream:Edit + Zone Firewall:Edit) — pregame scripting
CF_STREAM_TOKEN=

# Existing per-team CF live inputs (the Mevo/volunteer chain publishes here)
CF_INPUT_A_U15=

# GameChanger clean passthrough (Phase 4) — fresh key every game
GC_RTMP_URL=
GC_STREAM_KEY=

# gc-poller → scorebug worker bearer (same value as the worker's POLLER_TOKEN
# secret, set via `wrangler secret put POLLER_TOKEN`)
POLLER_TOKEN=
# Test hook: a completed GC game id to replay as if live (blank in production)
FORCE_EVENT_ID=
