  <script>
    function setLang(lang) {
      document.body.className = 'lang-' + lang;
      document.documentElement.lang = lang;
      document.getElementById('btn-fr').classList.toggle('active', lang === 'fr');
      document.getElementById('btn-en').classList.toggle('active', lang === 'en');
      localStorage.setItem('lang', lang);
    }

    function switchTeam(teamKey) {
      document.querySelectorAll('.team-panel').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.team-tab').forEach(t => t.classList.remove('active'));
      document.getElementById('panel-' + teamKey).classList.add('active');
      document.getElementById('tab-' + teamKey).classList.add('active');
      localStorage.setItem('activeTeam', teamKey);
    }

    // Stats drawer toggle
    function toggleDrawer(id) {
      var row = document.getElementById('drawer-' + id);
      var trigger = row.previousElementSibling;
      var isOpen = row.classList.contains('open');
      row.classList.toggle('open', !isOpen);
      trigger.classList.toggle('open', !isOpen);
    }

    // Stat tab switcher inside a drawer
    function switchStatTab(e, playerId, panel) {
      e.stopPropagation();
      var drawer = document.getElementById('drawer-' + playerId);
      drawer.querySelectorAll('.stat-tab').forEach(t => t.classList.remove('active'));
      drawer.querySelectorAll('.stat-panel').forEach(p => p.classList.remove('active'));
      e.currentTarget.classList.add('active');
      document.getElementById(playerId + '-' + panel).classList.add('active');
    }

    // Restore saved preferences on load
    (function() {
      var lang = localStorage.getItem('lang');
      if (lang === 'en') setLang('en');

      var team = localStorage.getItem('activeTeam') || 'u15';
      if (team !== 'u15') {
        document.querySelectorAll('.team-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.team-tab').forEach(t => t.classList.remove('active'));
        var panel = document.getElementById('panel-' + team);
        var tab   = document.getElementById('tab-' + team);
        if (panel) panel.classList.add('active');
        if (tab)   tab.classList.add('active');
      }
    })();
  </script>
