  <style>
    :root {
      --navy:       #0d1f4e;
      --navy-mid:   #152960;
      --navy-light: #1e3a8a;
      --sky:        #6ab0d4;
      --sky-light:  #a8d4ec;
      --sky-pale:   #daeef8;
      --white:      #ffffff;
      --off-white:  #f4f7fa;
      --gray:       #6b7280;
      --gray-light: #e5e7eb;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Barlow', sans-serif; background: var(--off-white); color: var(--navy); overflow-x: hidden; }

    /* BILINGUAL */
    .en-text { display: none !important; }
    body.lang-en .fr-text { display: none !important; }
    body.lang-en .en-text { display: revert !important; }

    /* LANG BAR */
    .lang-bar { background: var(--navy); display: flex; justify-content: flex-end; align-items: center; padding: 5px 28px; gap: 6px; }
    .lang-btn { background: none; border: 1.5px solid rgba(255,255,255,0.25); color: rgba(255,255,255,0.6); font-family: 'Barlow Condensed', sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0.1em; padding: 3px 11px; border-radius: 3px; cursor: pointer; transition: all 0.18s; }
    .lang-btn.active, .lang-btn:hover { background: var(--sky); border-color: var(--sky); color: var(--navy); }

    /* HEADER */
    header { background: var(--navy); padding: 0; }
    header::after { content: ''; display: block; height: 4px; background: linear-gradient(90deg, var(--navy) 0%, var(--sky) 30%, var(--sky-light) 50%, var(--sky) 70%, var(--navy) 100%); }
    .header-inner { display: flex; align-items: center; justify-content: center; padding: 16px 28px; }
    .logo-img { height: 110px; width: auto; display: block; transition: transform 0.2s ease; }
    .logo-img:hover { transform: scale(1.03); }

    /* NAV */
    nav { background: var(--navy-mid); border-bottom: 3px solid var(--sky); }
    .nav-inner { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; padding: 0 12px; }
    .nav-inner a { font-family: 'Barlow Condensed', sans-serif; font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.8); text-decoration: none; padding: 13px 15px; transition: all 0.18s; position: relative; white-space: nowrap; }
    .nav-inner a:hover, .nav-inner a.active { color: var(--sky-light); background: rgba(106,176,212,0.08); }
    .nav-inner a.active::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: var(--sky); }

    /* PAGE HEADER */
    .page-header { background: var(--navy); padding: 36px 28px 32px; text-align: center; }
    .page-header h1 { font-family: 'Barlow Condensed', sans-serif; font-size: clamp(36px, 6vw, 64px); font-weight: 900; text-transform: uppercase; color: var(--white); letter-spacing: 0.03em; line-height: 1; }
    .page-header h1 span { color: var(--sky-light); }
    .page-header-sub { font-size: 13px; color: rgba(255,255,255,0.5); margin-top: 8px; letter-spacing: 0.06em; font-family: 'Barlow Condensed', sans-serif; text-transform: uppercase; }

    /* TEAM TABS */
    .team-tabs-wrap { background: var(--navy-mid); border-bottom: 3px solid var(--sky); }
    .team-tabs { max-width: 1100px; margin: 0 auto; display: flex; padding: 0 24px; }
    .team-tab { font-family: 'Barlow Condensed', sans-serif; font-size: 14px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.55); padding: 14px 24px; cursor: pointer; border: none; background: none; position: relative; transition: all 0.18s; white-space: nowrap; }
    .team-tab:hover { color: var(--sky-light); }
    .team-tab.active { color: var(--sky-light); background: rgba(106,176,212,0.08); }
    .team-tab.active::after { content: ''; position: absolute; bottom: -3px; left: 0; right: 0; height: 3px; background: var(--sky); }

    /* MAIN WRAP */
    .roster-wrap { max-width: 1100px; margin: 0 auto; padding: 36px 24px 64px; }

    /* TEAM PANELS */
    .team-panel { display: none; }
    .team-panel.active { display: block; }

    /* PANEL HEADING */
    .panel-heading { margin-bottom: 28px; padding-bottom: 16px; border-bottom: 2px solid var(--sky-pale); }
    .panel-heading h2 { font-family: 'Barlow Condensed', sans-serif; font-size: 28px; font-weight: 900; text-transform: uppercase; color: var(--navy); letter-spacing: 0.04em; }
    .panel-heading h2 span { color: var(--sky); }
    .panel-heading-sub { font-size: 12px; color: var(--gray); font-family: 'Barlow Condensed', sans-serif; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 4px; }

    /* SECTION */
    .roster-section { margin-bottom: 32px; }
    .section-header { background: var(--navy); color: var(--white); font-family: 'Barlow Condensed', sans-serif; font-size: 13px; font-weight: 800; letter-spacing: 0.15em; text-transform: uppercase; padding: 10px 18px; border-radius: 4px 4px 0 0; border-left: 4px solid var(--sky); }

    /* TABLE */
    .roster-table { width: 100%; border-collapse: collapse; background: var(--white); border: 1px solid var(--gray-light); border-top: none; border-radius: 0 0 4px 4px; overflow: hidden; }
    .roster-table thead tr { background: var(--navy-mid); }
    .roster-table thead th { font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.65); padding: 10px 14px; text-align: left; border: none; }
    .roster-table thead th.center { text-align: center; }
    .roster-table tbody tr { border-bottom: 1px solid var(--gray-light); transition: background 0.12s; }
    .roster-table tbody tr:last-child { border-bottom: none; }
    .roster-table tbody tr:nth-child(even) { background: var(--off-white); }
    .roster-table tbody tr:hover { background: var(--sky-pale); }
    .roster-table tbody td { padding: 11px 14px; font-size: 14px; color: var(--navy); }
    .roster-table tbody td.center { text-align: center; }

    /* NUMBER BADGE */
    .num-badge { display: inline-flex; align-items: center; justify-content: center; background: var(--navy); color: var(--sky-light); font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 13px; border-radius: 3px; min-width: 28px; height: 22px; padding: 0 5px; }
    .num-badge.no-num { background: var(--gray-light); color: var(--gray); font-size: 11px; }

    /* PLAYER NAME */
    .player-name { font-weight: 600; color: var(--navy); }

    /* POSITION BADGE */
    .pos-badge { display: inline-block; background: var(--sky-pale); color: var(--navy-light); font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; padding: 2px 7px; border-radius: 3px; border: 1px solid rgba(106,176,212,0.4); }
    .bt-cell { font-family: 'Barlow Condensed', sans-serif; font-size: 13px; font-weight: 700; color: var(--gray); }
    .ht-cell, .wt-cell { font-family: 'Barlow Condensed', sans-serif; font-size: 13px; }

    /* PERSONNEL TABLE */
    .personnel-table { width: 100%; border-collapse: collapse; background: var(--white); border: 1px solid var(--gray-light); border-top: none; border-radius: 0 0 4px 4px; overflow: hidden; }
    .personnel-table tbody tr { border-bottom: 1px solid var(--gray-light); transition: background 0.12s; }
    .personnel-table tbody tr:last-child { border-bottom: none; }
    .personnel-table tbody tr:nth-child(even) { background: var(--off-white); }
    .personnel-table tbody tr:hover { background: var(--sky-pale); }
    .personnel-table tbody td { padding: 11px 18px; font-size: 14px; color: var(--navy); }
    .personnel-table td.p-name { font-weight: 600; }
    .personnel-table td.role { color: var(--gray); font-size: 12px; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }

    /* STATS DRAWER */
    tr.has-stats td.player-name { cursor: pointer; }
    tr.has-stats td.player-name .player-toggle { display: inline-flex; align-items: center; gap: 6px; }
    tr.has-stats td.player-name .player-toggle::after { content: '▸'; font-size: 10px; color: var(--sky); transition: transform 0.2s; }
    tr.has-stats.open td.player-name .player-toggle::after { transform: rotate(90deg); }
    tr.stats-drawer { display: none; }
    tr.stats-drawer.open { display: table-row; }
    tr.stats-drawer td { padding: 0; border-bottom: 2px solid var(--sky); }
    .drawer-inner { background: var(--navy); padding: 16px 20px 20px; }
    .stat-tabs { display: flex; gap: 0; margin-bottom: 14px; border-bottom: 2px solid rgba(255,255,255,0.1); }
    .stat-tab { font-family: 'Barlow Condensed', sans-serif; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.45); padding: 7px 16px; cursor: pointer; border: none; background: none; position: relative; transition: color 0.15s; }
    .stat-tab:hover { color: var(--sky-light); }
    .stat-tab.active { color: var(--sky-light); }
    .stat-tab.active::after { content: ''; position: absolute; bottom: -2px; left: 0; right: 0; height: 2px; background: var(--sky); }
    .stat-panel { display: none; }
    .stat-panel.active { display: block; }
    .stat-label { font-family: 'Barlow Condensed', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.35); margin-bottom: 10px; }
    .stat-grid { display: flex; flex-wrap: wrap; gap: 8px 0; }
    .stat-cell { display: flex; flex-direction: column; align-items: center; min-width: 70px; padding: 0 12px; border-right: 1px solid rgba(255,255,255,0.08); }
    .stat-cell:first-child { padding-left: 0; }
    .stat-cell:last-child { border-right: none; }
    .stat-val { font-family: 'Barlow Condensed', sans-serif; font-size: 22px; font-weight: 900; color: var(--white); line-height: 1; }
    .stat-val.highlight { color: var(--sky-light); }
    .stat-key { font-family: 'Barlow Condensed', sans-serif; font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-top: 3px; }
    .stat-season { font-family: 'Barlow Condensed', sans-serif; font-size: 10px; color: rgba(255,255,255,0.25); letter-spacing: 0.08em; text-transform: uppercase; margin-top: 12px; }
    .stats-pending { font-size: 13px; color: rgba(255,255,255,0.55); padding: 4px 0 8px; }
    .historical-block { margin-top: 16px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.08); }
    .historical-label { font-family: 'Barlow Condensed', sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.35); margin-bottom: 10px; }
    .personnel-table td.coach-num { width: 56px; padding-left: 18px; }

    /* COMING SOON PANEL */
    .coming-soon { text-align: center; padding: 72px 24px; }
    .coming-soon-icon { font-size: 48px; margin-bottom: 16px; opacity: 0.35; }
    .coming-soon h3 { font-family: 'Barlow Condensed', sans-serif; font-size: 22px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; color: var(--navy); margin-bottom: 8px; }
    .coming-soon p { font-size: 13px; color: var(--gray); }

    /* FOOTER */
    footer { background: var(--navy); border-top: 4px solid var(--sky); padding: 32px 28px 20px; }
    .footer-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 28px; margin-bottom: 24px; }
    .footer-logo { height: 72px; width: auto; margin-bottom: 10px; }
    .footer-col-title { font-family: 'Barlow Condensed', sans-serif; font-size: 12px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; color: var(--sky-light); margin-bottom: 10px; }
    .footer-col p, .footer-col a { font-size: 12px; color: rgba(255,255,255,0.5); line-height: 1.9; text-decoration: none; display: block; }
    .footer-col a:hover { color: var(--sky-light); }
    .footer-bottom { max-width: 1100px; margin: 0 auto; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 6px; }
    .footer-bottom p { font-size: 10px; color: rgba(255,255,255,0.25); letter-spacing: 0.04em; }

    /* RESPONSIVE — ultrawide */
    @media (min-width: 1400px) {
      .header-inner { padding: 16px 48px; }
      .nav-inner a { font-size: 15px; padding: 15px 20px; }
      .page-header { padding: 44px 48px 38px; }
      .roster-wrap { max-width: 1380px; padding: 48px 48px 72px; }
      .team-tabs { max-width: 1380px; padding: 0 48px; }
      .footer-inner { max-width: 1380px; } .footer-bottom { max-width: 1380px; }
      .lang-bar { padding: 5px 48px; }
    }
    @media (min-width: 1800px) {
      .header-inner { padding: 20px 80px; }
      .nav-inner a { font-size: 16px; padding: 16px 24px; }
      .roster-wrap { max-width: 1680px; padding: 56px 80px 88px; }
      .team-tabs { max-width: 1680px; padding: 0 80px; }
      .footer-inner { max-width: 1680px; padding: 0 80px; } .footer-bottom { max-width: 1680px; padding-left: 80px; padding-right: 80px; }
      .lang-bar { padding: 6px 80px; }
    }
    @media (max-width: 820px) {
      .header-inner { padding: 12px 16px; }
      .roster-wrap { padding: 24px 16px 48px; }
      .footer-inner { grid-template-columns: 1fr; gap: 16px; }
      .team-tabs { padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); }
      .team-tab {
        padding: 16px 8px;
        font-size: 17px;
        letter-spacing: 0.06em;
        text-align: center;
        background: rgba(255,255,255,0.05);
        border-right: 1px solid rgba(255,255,255,0.08);
        color: rgba(255,255,255,0.7);
      }
      .team-tab:last-child { border-right: none; }
      .team-tab.active { background: rgba(106,176,212,0.15); color: var(--sky-light); }
    }
    @media (max-width: 560px) {
      .nav-inner a { padding: 10px 8px; font-size: 11px; }
      .roster-table thead th:nth-child(n+5),
      .roster-table tbody td:nth-child(n+5) { display: none; }
    }
  </style>
</head>
